MONGODB_USERNAME="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_DB="mobile-cases-ecommerce"
# Direct host list — used because the driver's SRV lookup is refused on this
# machine (querySrv ECONNREFUSED). If Atlas moves the shards, re-fetch these
# hosts and update the list.
MONGODB_URI="mongodb://<username>:<password>@host-00.example.mongodb.net:27017,host-01.example.mongodb.net:27017,host-02.example.mongodb.net:27017/mobile-cases-ecommerce?ssl=true&replicaSet=<replica-set>&retryWrites=true&w=majority&authSource=admin"

# Admin authentication
# Generate your own hash (do NOT reuse a published value) with:
#   npm run admin:hash -- "your-password"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="scrypt:<n>:<r>:<p>:<salt-hex>:<hash-hex>"
ADMIN_TEST_PASSWORD="" # plaintext, only for scripts/test-admin.mjs against .env.local (dev only)

# Payment provider (dummy = test provider that always succeeds; never use in production)
PAYMENT_PROVIDER="dummy"
DUMMY_WEBHOOK_SECRET="<random-hex>"